# Super Admin Account Configuration
# Generate a strong random secret and store it only in .env (never commit .env).
ADMIN_EMAIL="changeme@example.com"
ADMIN_PASSWORD="changeme"
ADMIN_PHONE="+201274422688"

# Database Configuration
DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/db"

# Optional: Object storage (R2 / S3)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# CDN_BASE_URL=""

# Optional: Redis cache
# REDIS_URL=""

# Optional: AI provider
# GEMINI_API_KEY=""

# Mandatory download token secret (fail closed if unset)
DOWNLOAD_SECRET="changeme"
