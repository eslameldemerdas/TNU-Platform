import "dotenv/config";
import express, { Request, Response, NextFunction } from "express";
import path from "path";
import fs from "fs";
import crypto from "crypto";
import bcrypt from "bcryptjs";
import { createServer as createViteServer } from "vite";
import { GoogleGenAI, Type } from "@google/genai";

import {
  AppError,
  BadRequestError,
  ValidationError,
  UnauthorizedError,
  ForbiddenError,
  NotFoundError,
  ConflictError,
  RateLimitError,
  ServiceUnavailableError,
  errorHandler
} from "./server/errors";

import { validate, Validators, sanitizePagination, RESOURCE_CATEGORIES, RESOURCE_FILE_TYPES } from "./server/validation";
import { serverCache } from "./server/cache";
import { AuditLogger } from "./server/audit";
import { SessionManager } from "./server/sessions";
import { db, StoredUser, StoredResource, Role, generateSignedDownloadToken, verifySignedDownloadToken } from "./server/db";
import { CourseService } from "./server/courseService";
import {
  getPresignedUploadUrl,
  getPresignedDownloadUrl,
  generateEncryptedFileName,
  getS3StorageConfig
} from "./server/s3-storage";

// Helper to extract cookies from request headers
function parseCookies(req: Request): Record<string, string> {
  const list: Record<string, string> = {};
  const rc = req.headers.cookie;
  if (!rc) return list;

  rc.split(";").forEach((cookie) => {
    const parts = cookie.split("=");
    const key = parts.shift()?.trim();
    if (key) {
      list[key] = decodeURIComponent(parts.join("="));
    }
  });

  return list;
}

// Client IP extractor
function getClientIp(req: Request): string {
  const forwarded = (req.headers["x-forwarded-for"] as string)?.split(",")[0]?.trim();
  return forwarded || req.ip || req.socket.remoteAddress || "127.0.0.1";
}

// Helper to extract and validate session user from authenticated session token EXCLUSIVELY
function getSessionUser(req: Request): StoredUser | null {
  const cookies = parseCookies(req);
  const authHeader = req.headers.authorization;
  const token = cookies.enghub_session || (authHeader ? authHeader.replace(/^Bearer\s+/i, "").trim() : "");
  if (!token) return null;

  const session = SessionManager.validate(token);
  if (!session) return null;

  const user = db.getUserByEmail(session.userEmail) || db.getUserById(session.userId);
  return user || null;
}

// Strict RBAC Authentication & Authorization Middlewares
function requireAuth(req: Request, _res: Response, next: NextFunction) {
  const user = getSessionUser(req);
  if (!user) {
    return next(new UnauthorizedError("Authentication session required. Please sign in."));
  }
  (req as any).user = user;
  next();
}

function requireRole(allowedRoles: string[]) {
  return (req: Request, _res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError("Authentication session required."));
    }
    if (!allowedRoles.includes(user.role)) {
      AuditLogger.log({
        category: "security",
        eventType: "security.rbac_forbidden_access",
        severity: "warning",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { path: req.path, method: req.method, requiredRoles: allowedRoles, currentRole: user.role }
      });
      return next(new ForbiddenError(`Access denied. Requires one of: ${allowedRoles.join(", ")}.`));
    }
    (req as any).user = user;
    next();
  };
}

const requireElevated = requireRole(["super_admin", "department_admin", "supervisor", "moderator"]);
const requireSuperAdmin = requireRole(["super_admin"]);

// Rate Limiting Store
interface RateBucket {
  count: number;
  resetAt: number;
}
const RATE_LIMIT_BUCKETS = new Map<string, RateBucket>();

function checkRateLimit(
  key: string,
  maxAttempts: number,
  windowMs: number
): { allowed: boolean; remainingSeconds: number } {
  const now = Date.now();
  let bucket = RATE_LIMIT_BUCKETS.get(key);

  if (!bucket || now > bucket.resetAt) {
    bucket = { count: 0, resetAt: now + windowMs };
    RATE_LIMIT_BUCKETS.set(key, bucket);
  }

  if (bucket.count >= maxAttempts) {
    return {
      allowed: false,
      remainingSeconds: Math.ceil((bucket.resetAt - now) / 1000)
    };
  }

  bucket.count += 1;
  return { allowed: true, remainingSeconds: 0 };
}

function resetRateLimit(key: string): void {
  RATE_LIMIT_BUCKETS.delete(key);
}

async function startServer() {
  const app = express();
  const PORT = 3000;

  // Global Middlewares
  app.use(express.json({ limit: "10mb" }));
  app.use(express.static(path.join(process.cwd(), "public"), {
    maxAge: "1d",
    etag: true
  }));

  // Observability: Request ID & Response Timing Middleware
  app.use((req: Request, res: Response, next: NextFunction) => {
    const reqId = `req-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`;
    const start = Date.now();

    req.headers["x-request-id"] = reqId;
    res.setHeader("X-Request-Id", reqId);

    // Record response completion safely without calling setHeader after finish
    res.on("finish", () => {
      const duration = Date.now() - start;
      if (duration > 1000) {
        console.warn(`[SLOW_REQ] ${req.method} ${req.originalUrl} took ${duration}ms (status: ${res.statusCode})`);
      }
    });

    next();
  });

  // Gemini AI Client Factory (Server-side only)
  const getGenAI = () => {
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      throw new Error("GEMINI_API_KEY environment variable is not set on the server.");
    }
    return new GoogleGenAI({
      apiKey,
      httpOptions: {
        headers: {
          "User-Agent": "aistudio-build",
        }
      }
    });
  };

  // ----------------------------------------------------
  // API ROUTES
  // ----------------------------------------------------

  // Health check
  app.get("/api/health", (_req: Request, res: Response) => {
    res.json({
      status: "ok",
      timestamp: new Date().toISOString(),
      service: "EngHub Hardened Backend API",
      architecture: "Express + Vite Full-Stack Engine",
      hasGeminiKey: Boolean(process.env.GEMINI_API_KEY),
      aiProvider: "Google Gemini (@google/genai)",
      cacheStats: serverCache.getStats()
    });
  });

  // ----------------------------------------------------
  // AUTHENTICATION & SECURITY ENDPOINTS
  // ----------------------------------------------------

  // Signup Endpoint
  app.post(
    "/api/auth/signup",
    validate({
      body: {
        fullName: Validators.string(2, 100),
        email: Validators.email(),
        phoneNumber: Validators.phone(),
        password: Validators.password(8),
        passwordConfirm: Validators.string(8, 100),
        departmentId: Validators.optional(Validators.string(2, 50)),
        level: Validators.optional(Validators.string(2, 50))
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      const clientIp = getClientIp(req);
      const rateKey = `signup:${clientIp}`;
      const rate = checkRateLimit(rateKey, 5, 15 * 60 * 1000); // 5 attempts per 15 min

      if (!rate.allowed) {
        AuditLogger.log({
          category: "security",
          eventType: "security.rate_limited",
          severity: "warning",
          actorId: "anonymous",
          actorName: "Unknown Guest",
          actorRole: "student",
          ipAddress: clientIp,
          metadata: { endpoint: "/api/auth/signup", remainingSeconds: rate.remainingSeconds }
        });
        return next(new RateLimitError(`Too many registration attempts. Please wait ${rate.remainingSeconds} seconds.`, rate.remainingSeconds));
      }

      try {
        const { fullName, email, phoneNumber, password, passwordConfirm, departmentId, level } = req.body;

        if (password !== passwordConfirm) {
          return next(new ValidationError("Passwords do not match."));
        }

        const normalizedEmail = email.trim().toLowerCase();

        // Email uniqueness check
        if (db.getUserByEmail(normalizedEmail)) {
          AuditLogger.log({
            category: "authentication",
            eventType: "auth.signup.conflict",
            severity: "warning",
            actorId: "anonymous",
            actorName: fullName.trim(),
            actorRole: "student",
            actorEmail: normalizedEmail,
            ipAddress: clientIp
          });
          return next(new ConflictError("An account with this email address already exists. Please sign in instead."));
        }

        const salt = await bcrypt.genSalt(10);
        const passwordHash = await bcrypt.hash(password, salt);

        const isFreshmanLevel = level === "Year 1 (Freshman)" || level === "المستوى الصفري {إعدادي}";
        const isSophomoreLevel = level === "Year 2 (Sophomore)" || level === "المستوى الأول {سنة تانية}";
        const isMtr = departmentId === "dept-mtr" || departmentId === "dept-mtr-01";
        const isMtrLevel1 = isMtr && (isSophomoreLevel || isFreshmanLevel || level?.includes("المستوى الأول") || level?.includes("سنة ثانية"));

        const mechatronicsCourses = [
          "course-engx13-mtr",
          "course-mpe121-mtr",
          "course-pde111-mtr",
          "course-epe111-mtr",
          "course-hum131-mtr",
          "course-humxe1-mtr"
        ];
        const freshmanCourses = ["course-eng011", "course-eng021", "course-eng041", "course-eng031", "course-eng051", "course-hum011"];
        const sophomoreCourses = ["course-hum131", "course-engx13", "course-aie101", "course-aie111", "course-aie103", "course-humx32"];

        const defaultEnrolled = isMtrLevel1 ? mechatronicsCourses : isFreshmanLevel ? freshmanCourses : sophomoreCourses;

        const userId = `usr-${Date.now()}`;
        const newUser: StoredUser = {
          id: userId,
          name: fullName.trim(),
          email: normalizedEmail,
          phoneNumber: phoneNumber.trim(),
          passwordHash,
          studentId: `2026-ENG-${Math.floor(1000 + Math.random() * 9000)}`,
          role: "student",
          universityId: "uni-gnue-01",
          facultyId: "fac-eng-01",
          departmentId: departmentId || "dept-cmp-01",
          level: level || "Year 1 (Freshman)",
          semester: "Fall 2026",
          avatar: `https://images.unsplash.com/photo-${1534528741775 + Math.floor(Math.random() * 100)}?w=150&auto=format&fit=crop&q=80`,
          bio: "Engineering student at Faculty of Engineering.",
          points: 25, // Signup bonus
          badges: [
            { id: "badge-welcome", name: "Engineering Pioneer", description: "Joined the Faculty of Engineering Portal.", icon: "GraduationCap", earnedAt: "Today", color: "bg-indigo-500/10 text-indigo-500 border-indigo-500/20" }
          ],
          savedBookmarks: [],
          enrolledCourseIds: defaultEnrolled,
          createdAt: new Date().toISOString()
        };

        db.saveUser(newUser);
        resetRateLimit(rateKey);

        // Create Session & Set Cookie
        const { token } = SessionManager.create(newUser.id, newUser.email, clientIp, req.headers["user-agent"]);

        res.setHeader(
          "Set-Cookie",
          `enghub_session=${token}; HttpOnly; Path=/; Max-Age=${7 * 24 * 3600}; SameSite=Lax${process.env.NODE_ENV === "production" ? "; Secure" : ""}`
        );

        // Invalidate admin cached user stats
        serverCache.invalidatePattern("admin:");

        AuditLogger.log({
          category: "authentication",
          eventType: "auth.signup.success",
          severity: "info",
          actorId: newUser.id,
          actorName: newUser.name,
          actorRole: newUser.role,
          actorEmail: newUser.email,
          ipAddress: clientIp
        });

        res.status(201).json({
          success: true,
          message: "Account created successfully! Welcome to EngHub.",
          user: db.toSafeUser(newUser),
          sessionToken: token
        });
      } catch (err) {
        next(err);
      }
    }
  );

  // Login Endpoint
  app.post(
    "/api/auth/login",
    validate({
      body: {
        email: Validators.email(),
        password: Validators.string(1, 200)
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      const clientIp = getClientIp(req);
      const rateKey = `login:${clientIp}`;
      const rate = checkRateLimit(rateKey, 5, 15 * 60 * 1000);

      if (!rate.allowed) {
        AuditLogger.log({
          category: "security",
          eventType: "security.rate_limited",
          severity: "warning",
          actorId: "anonymous",
          actorName: "Unknown Guest",
          actorRole: "student",
          ipAddress: clientIp,
          metadata: { endpoint: "/api/auth/login", remainingSeconds: rate.remainingSeconds }
        });
        return next(new RateLimitError(`Too many failed login attempts. Account protection triggered. Please retry in ${rate.remainingSeconds} seconds.`, rate.remainingSeconds));
      }

      try {
        const { email, password } = req.body;
        const normalizedEmail = email.trim().toLowerCase();
        const user = db.getUserByEmail(normalizedEmail);

        if (!user) {
          AuditLogger.log({
            category: "authentication",
            eventType: "auth.login.failure",
            severity: "warning",
            actorId: "anonymous",
            actorName: "Unknown",
            actorRole: "student",
            actorEmail: normalizedEmail,
            ipAddress: clientIp,
            metadata: { reason: "User not found" }
          });
          return next(new UnauthorizedError("Invalid email or password. Please verify your credentials."));
        }

        const isMatch = await bcrypt.compare(password, user.passwordHash);

        if (!isMatch) {
          AuditLogger.log({
            category: "authentication",
            eventType: "auth.login.failure",
            severity: "warning",
            actorId: user.id,
            actorName: user.name,
            actorRole: user.role,
            actorEmail: normalizedEmail,
            ipAddress: clientIp,
            metadata: { reason: "Incorrect password" }
          });
          return next(new UnauthorizedError("Invalid email or password. Please verify your credentials."));
        }

        // Successful Login
        resetRateLimit(rateKey);

        const { token } = SessionManager.create(user.id, user.email, clientIp, req.headers["user-agent"]);

        res.setHeader(
          "Set-Cookie",
          `enghub_session=${token}; HttpOnly; Path=/; Max-Age=${7 * 24 * 3600}; SameSite=Lax${process.env.NODE_ENV === "production" ? "; Secure" : ""}`
        );

        AuditLogger.log({
          category: "authentication",
          eventType: "auth.login.success",
          severity: "info",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          actorEmail: user.email,
          ipAddress: clientIp
        });

        res.json({
          success: true,
          message: "Signed in successfully!",
          user: db.toSafeUser(user),
          sessionToken: token
        });
      } catch (err) {
        next(err);
      }
    }
  );

  // Logout Endpoint
  app.post("/api/auth/logout", (req: Request, res: Response) => {
    const cookies = parseCookies(req);
    const token = cookies.enghub_session || req.headers.authorization?.replace("Bearer ", "");
    const user = getSessionUser(req);

    if (token) {
      SessionManager.revoke(token);
    }

    if (user) {
      AuditLogger.log({
        category: "authentication",
        eventType: "auth.logout",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        actorEmail: user.email,
        ipAddress: getClientIp(req)
      });
    }

    res.setHeader(
      "Set-Cookie",
      `enghub_session=; HttpOnly; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax`
    );

    res.json({ success: true, message: "Signed out successfully." });
  });

  // Current Authenticated User Endpoint
  app.get("/api/auth/me", (req: Request, res: Response, next: NextFunction) => {
    const cookies = parseCookies(req);
    const token = cookies.enghub_session || req.headers.authorization?.replace("Bearer ", "");

    if (!token) {
      return res.status(401).json({ authenticated: false, message: "No active session." });
    }

    const session = SessionManager.validate(token);
    if (!session) {
      return res.status(401).json({ authenticated: false, message: "Session expired." });
    }

    const user = db.getUserByEmail(session.userEmail);
    if (!user) {
      return res.status(404).json({ authenticated: false, message: "User not found." });
    }

    res.json({
      authenticated: true,
      user: db.toSafeUser(user)
    });
  });

  // Change Password Endpoint
  app.post(
    "/api/auth/change-password",
    validate({
      body: {
        currentPassword: Validators.string(1, 200),
        newPassword: Validators.password(8),
        confirmNewPassword: Validators.string(8, 200),
        revokeOtherSessions: Validators.optional(Validators.boolean())
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError());
      }

      const clientIp = getClientIp(req);
      const { currentPassword, newPassword, confirmNewPassword, revokeOtherSessions } = req.body;

      if (newPassword !== confirmNewPassword) {
        return next(new ValidationError("New passwords do not match."));
      }

      if (currentPassword === newPassword) {
        return next(new ValidationError("New password must be different from current password."));
      }

      const isCurrentValid = await bcrypt.compare(currentPassword, user.passwordHash);
      if (!isCurrentValid) {
        AuditLogger.log({
          category: "security",
          eventType: "auth.password.failed_verification",
          severity: "warning",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          actorEmail: user.email,
          ipAddress: clientIp
        });
        return next(new BadRequestError("Incorrect current password."));
      }

      const salt = await bcrypt.genSalt(10);
      user.passwordHash = await bcrypt.hash(newPassword, salt);
      db.saveUser(user);

      const cookies = parseCookies(req);
      const currentToken = cookies.enghub_session || req.headers.authorization?.replace("Bearer ", "");

      if (revokeOtherSessions) {
        SessionManager.revokeAll(user.id, currentToken);
      }

      AuditLogger.log({
        category: "security",
        eventType: "auth.password.changed",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        actorEmail: user.email,
        ipAddress: clientIp,
        metadata: { revokeOtherSessions: Boolean(revokeOtherSessions) }
      });

      res.json({
        success: true,
        message: "Password changed successfully."
      });
    }
  );

  // Update Profile Endpoint (Name, Avatar, and Bio ONLY for authenticated user)
  app.patch(
    "/api/auth/profile",
    validate({
      body: {
        name: Validators.optional(Validators.string(1, 200)),
        avatar: Validators.optional(Validators.string(1, 10000000)),
        bio: Validators.optional(Validators.string(0, 2000))
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("Authentication session required to update profile."));
      }

      const clientIp = getClientIp(req);
      const { name, avatar, bio } = req.body;

      if (name !== undefined && name.trim()) user.name = name.trim();
      if (avatar !== undefined) user.avatar = avatar.trim();
      if (bio !== undefined) user.bio = bio.trim();

      db.saveUser(user);

      AuditLogger.log({
        category: "authentication",
        eventType: "user.profile.updated",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        actorEmail: user.email,
        ipAddress: clientIp,
        metadata: { updatedFields: Object.keys(req.body) }
      });

      res.json({
        success: true,
        message: "Profile updated successfully.",
        user: db.toSafeUser(user)
      });
    }
  );

  // Active Sessions Listing (Multi-Device Management)
  app.get("/api/auth/sessions", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError());
    }

    const cookies = parseCookies(req);
    const currentToken = cookies.enghub_session || req.headers.authorization?.replace("Bearer ", "");
    let sessions = SessionManager.getSessionsForUser(user.id, currentToken);

    if (sessions.length === 0) {
      sessions = [
        {
          id: `sess-current-${user.id}`,
          deviceInfo: SessionManager.parseUserAgent(req.headers["user-agent"]),
          ipAddress: getClientIp(req),
          createdAt: user.createdAt || new Date().toISOString(),
          lastUsedAt: new Date().toISOString(),
          isCurrent: true
        }
      ];
    }

    res.json({
      success: true,
      sessions,
      total: sessions.length
    });
  });

  // Revoke Specific Session Endpoint (Supports POST and DELETE)
  const handleRevokeSession = (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError());
    }

    const { sessionId } = req.params;
    if (sessionId.startsWith("sess-current-")) {
      return res.json({
        success: true,
        message: "Current active session cannot be revoked from here."
      });
    }

    const revoked = SessionManager.revokeById(sessionId, user.id);

    AuditLogger.log({
      category: "security",
      eventType: "auth.session.revoked",
      severity: "info",
      actorId: user.id,
      actorName: user.name,
      actorRole: user.role,
      actorEmail: user.email,
      targetId: sessionId,
      targetType: "session",
      ipAddress: getClientIp(req)
    });

    res.json({
      success: true,
      message: "Session terminated successfully."
    });
  };

  app.delete("/api/auth/sessions/:sessionId", handleRevokeSession);
  app.delete("/api/auth/sessions/:sessionId/revoke", handleRevokeSession);
  app.post("/api/auth/sessions/:sessionId/revoke", handleRevokeSession);

  // Logout All Other Sessions
  app.post("/api/auth/logout-all", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError());
    }

    const cookies = parseCookies(req);
    const currentToken = cookies.enghub_session || req.headers.authorization?.replace("Bearer ", "");
    const count = SessionManager.revokeAll(user.id, currentToken);

    AuditLogger.log({
      category: "security",
      eventType: "auth.sessions.revoked_all",
      severity: "warning",
      actorId: user.id,
      actorName: user.name,
      actorRole: user.role,
      actorEmail: user.email,
      ipAddress: getClientIp(req),
      metadata: { revokedSessionCount: count }
    });

    res.json({
      success: true,
      message: `Successfully signed out of ${count} other device(s).`,
      revokedCount: count
    });
  });

  // ----------------------------------------------------
  // NOTIFICATIONS API (Category-based, Session-Authorized, IDOR-Protected)
  // ----------------------------------------------------

  app.get("/api/notifications", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return res.json({ notifications: [], total: 0, unreadCount: 0, page: 1, limit: 20 });
    }
    const currentUserId = user.id;

    const { category, unreadOnly } = req.query;
    const { page, limit } = sanitizePagination(req.query, 10, 50);

    const result = db.queryNotifications(currentUserId, {
      category: category as string,
      unreadOnly: unreadOnly === "true",
      page,
      limit
    });

    res.json(result);
  });

  app.post(
    "/api/notifications/:id/read",
    validate({
      params: {
        id: Validators.string(1, 100)
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("Authentication session required."));
      }
      const currentUserId = user.id;
      const { id } = req.params;

      const notif = db.notificationsList.find((n) => n.id === id);
      if (!notif) {
        return next(new NotFoundError("Notification not found."));
      }

      // IDOR Protection: verify ownership
      if (notif.userId !== currentUserId && notif.userId !== "all") {
        AuditLogger.log({
          category: "security",
          eventType: "security.idor_attempt",
          severity: "critical",
          actorId: currentUserId,
          actorName: user.name,
          actorRole: user.role,
          targetId: id,
          targetType: "notification",
          ipAddress: getClientIp(req)
        });
        return next(new ForbiddenError("Forbidden: You cannot modify notifications belonging to another user."));
      }

      notif.read = true;
      const remainingUnread = db.notificationsList.filter((n) => (n.userId === currentUserId || n.userId === "all") && !n.read).length;

      res.json({
        success: true,
        notification: notif,
        unreadCount: remainingUnread
      });
    }
  );

  app.post("/api/notifications/read-all", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError("Authentication session required."));
    }
    const currentUserId = user.id;

    db.notificationsList.forEach((n) => {
      if (n.userId === currentUserId || n.userId === "all") {
        n.read = true;
      }
    });

    res.json({
      success: true,
      message: "All notifications marked as read.",
      unreadCount: 0
    });
  });

  // ----------------------------------------------------
  // STUDENT-TO-STUDENT RESOURCES & VERIFICATION SYSTEM API
  // ----------------------------------------------------

  // GET /api/resources (Filtered, Paginated, Scoped by Moderation Lifecycle)
  app.get("/api/resources", (req: Request, res: Response) => {
    const user = getSessionUser(req);
    const {
      courseId,
      departmentId,
      category,
      semester,
      academicYear,
      verificationStatus,
      moderationStatus,
      uploaderId,
      search,
      sortBy
    } = req.query;
    const { page, limit } = sanitizePagination(req.query, 20, 50);

    const result = db.queryResources({
      courseId: courseId as string,
      departmentId: departmentId as string,
      category: category as string,
      semester: semester as string,
      academicYear: academicYear as string,
      verificationStatus: verificationStatus as string,
      moderationStatus: moderationStatus as string,
      uploaderId: uploaderId as string,
      search: search as string,
      sortBy: sortBy as any,
      page,
      limit,
      currentUserId: user?.id,
      currentUserRole: user?.role,
      currentUserDept: user?.departmentId
    });

    res.json(result);
  });

  // POST /api/resources (Student Resource Upload & Submission to Moderation Queue)
  app.post(
    "/api/resources",
    validate({
      body: {
        title: Validators.string(5, 150),
        description: Validators.string(10, 1000),
        category: Validators.enum(RESOURCE_CATEGORIES),
        courseId: Validators.string(2, 50),
        courseCode: Validators.string(2, 50),
        courseTitle: Validators.optional(Validators.string(2, 100)),
        departmentId: Validators.string(2, 50),
        academicYear: Validators.optional(Validators.string(2, 50)),
        semester: Validators.optional(Validators.string(2, 50)),
        fileType: Validators.enum(RESOURCE_FILE_TYPES),
        fileName: Validators.string(3, 200),
        fileSizeBytes: Validators.optional(Validators.integer(1, 30 * 1024 * 1024)),
        fileSize: Validators.optional(Validators.string(1, 50)),
        fileData: Validators.optional(Validators.string(0, 10 * 1024 * 1024)),
        previewContent: Validators.optional(Validators.string(0, 5000)),
        tags: Validators.optional(Validators.array(Validators.string(1, 30), 0, 10))
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("You must be logged in to contribute academic resources."));
      }

      const {
        title,
        description,
        category,
        courseId,
        courseCode,
        courseTitle,
        departmentId,
        academicYear,
        semester,
        fileType,
        fileName,
        fileSizeBytes,
        fileSize,
        fileData,
        previewContent,
        tags
      } = req.body;

      const bytes = fileSizeBytes || 2.4 * 1024 * 1024;
      const sizeText = fileSize || `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      const resourceId = `file-${Date.now()}`;

      // Privilege check: faculty admins or moderators uploading official resources
      const isElevated = ["super_admin", "department_admin", "moderator", "supervisor"].includes(user.role);

      // Student restriction: regular users / students can ONLY upload summaries and rules
      const allowedStudentCategories = ["summary", "cheat_sheet", "study_guide"];
      if (!isElevated && !allowedStudentCategories.includes(category)) {
        return next(
          new ForbiddenError(
            "غير مصرح للطلاب برفع هذا النوع من الملفات. يُسمح للطلاب فقط برفع الملخصات والقوانين المركزة (Summaries & Rules) وتخضع للتدقيق والاعتماد من الإشراف الأكاديمي."
          )
        );
      }

      const initialModeration = isElevated ? "approved" : "pending";
      const initialVerification = isElevated ? "official" : "student_uploaded";
      const initialStatus = isElevated ? "approved" : "pending";

      const newResource: StoredResource = {
        id: resourceId,
        title: title.trim(),
        description: description.trim(),
        category,
        resourceType: (category as string) || "lecture",
        fileKey: (req.body.fileKey as string) || `uploads/2026/courses/${courseId}/${resourceId}.${fileType}`,
        courseId,
        courseCode: courseCode.trim().toUpperCase(),
        courseTitle: courseTitle?.trim() || courseCode,
        departmentId: departmentId || user.departmentId || "dept-cmp",
        academicYear: academicYear || user.level || "Year 2 (Sophomore)",
        semester: semester || user.semester || "Fall 2026",
        fileType,
        fileName: fileName.trim(),
        fileSize: sizeText,
        fileSizeBytes: bytes,
        fileData,
        previewContent,
        uploaderId: user.id,
        uploaderName: user.name,
        uploaderRole: user.role,
        uploaderDepartment: user.departmentId === "dept-mtr" ? "هندسة الميكاترونكس" : "هندسة الحاسب والذكاء الاصطناعي",
        uploadDate: new Date().toISOString().split("T")[0],
        downloadCount: 0,
        viewCount: 1,
        rating: 5.0,
        ratingCount: 0,
        helpfulCount: 0,
        notHelpfulCount: 0,
        helpfulVotedUsers: new Map(),
        downloadUrl: `/api/files/download/${resourceId}`,
        status: initialStatus,
        moderationStatus: initialModeration,
        verificationStatus: initialVerification,
        moderatedBy: isElevated ? user.id : undefined,
        moderatedByName: isElevated ? user.name : undefined,
        moderatedAt: isElevated ? new Date().toISOString() : undefined,
        version: 1,
        tags: Array.isArray(tags) && tags.length > 0 ? tags : [courseCode, category],
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      };

      db.saveResource(newResource);

      // Student feedback notification
      db.saveNotification({
        id: `notif-${Date.now()}-student`,
        userId: user.id,
        category: "academic",
        type: isElevated ? "resource_approved" : "resource_pending",
        title: isElevated ? "Resource Published Instantly" : "Resource Submitted to Moderation Queue",
        titleAr: isElevated ? "تم نشر الملف الأكاديمي مباشرة" : "تم إرسال الملخص لطابور المراجعة والتدقيق",
        message: isElevated
          ? `Your official resource "${newResource.title}" is now live for all students.`
          : `Your summary/rules "${newResource.title}" was received and will be reviewed by supervisors (+15 pts upon approval).`,
        messageAr: isElevated
          ? `تم نشر مرجعك الأكاديمي المعتمد "${newResource.title}" بنجاح للطلاب.`
          : `تم استلام ملخصك "${newResource.title}" وتم إرسال إشعار للمشرفين والإدارة للمراجعة والاعتماد (+15 نقطة فور الموافقة).`,
        read: false,
        createdAt: new Date().toISOString(),
        actionTab: "courses",
        actionTargetId: courseId
      });

      // If submitted by student, notify all admins and supervisors immediately
      if (!isElevated) {
        const staffUsers = Array.from(db.usersById.values()).filter((u) =>
          ["super_admin", "department_admin", "moderator", "supervisor"].includes(u.role)
        );
        staffUsers.forEach((staff) => {
          db.saveNotification({
            id: `notif-${Date.now()}-staff-${staff.id}`,
            userId: staff.id,
            category: "system",
            type: "resource_pending",
            title: "New Student Summary Pending Review",
            titleAr: "ملخص وقوانين جديدة بحاجة للاعتماد 📄",
            message: `Student ${user.name} submitted a summary for ${newResource.courseCode}: "${newResource.title}".`,
            messageAr: `قام الطالب ${user.name} برفع ملخص/قوانين لمقرر ${newResource.courseCode} بعنوان "${newResource.title}" بانتظار موافقتك واعتماده.`,
            read: false,
            createdAt: new Date().toISOString(),
            actionTab: "admin",
            actionTargetId: newResource.id
          });
        });
      }

      AuditLogger.log({
        category: "moderation",
        eventType: "resource.submitted",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        targetId: newResource.id,
        targetType: "resource",
        targetName: newResource.title,
        metadata: {
          courseCode: newResource.courseCode,
          category: newResource.category,
          moderationStatus: newResource.moderationStatus,
          verificationStatus: newResource.verificationStatus
        },
        ipAddress: getClientIp(req)
      });

      res.status(201).json({
        success: true,
        resource: db.toSafeResource(newResource, user.id),
        message: isElevated
          ? "تم نشر الملف بنجاح وتوثيقه كملف رسمي معتمد!"
          : "تم رفع الملف بنجاح وإرساله إلى طابور المراجعة والتدقيق الأكاديمي."
      });
    }
  );

  // PATCH /api/resources/:id/moderate (Elevated Moderator & Admin Approval/Rejection/Verification)
  app.patch(
    "/api/resources/:id/moderate",
    validate({
      params: {
        id: Validators.string(1, 100)
      },
      body: {
        action: Validators.enum(["approve", "reject", "verify", "unverify"]),
        rejectionReason: Validators.optional(Validators.string(5, 500)),
        category: Validators.optional(Validators.enum(RESOURCE_CATEGORIES)),
        tags: Validators.optional(Validators.array(Validators.string(1, 30), 0, 10))
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("Authentication required."));
      }

      const isElevated = ["super_admin", "department_admin", "moderator", "supervisor"].includes(user.role);
      if (!isElevated) {
        AuditLogger.log({
          category: "security",
          eventType: "security.unauthorized_moderation_attempt",
          severity: "warning",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          targetId: req.params.id,
          targetType: "resource",
          ipAddress: getClientIp(req)
        });
        return next(new ForbiddenError("Access forbidden: Elevated moderator or admin role required."));
      }

      const { id } = req.params;
      const resource = db.getResourceById(id);
      if (!resource) {
        return next(new NotFoundError("Resource not found."));
      }

      // Department scope authorization for department admins
      if (user.role === "department_admin" && user.departmentId && resource.departmentId) {
        if (resource.departmentId !== user.departmentId && resource.departmentId !== "dept-cmp") {
          return next(new ForbiddenError("Department Admins can only moderate resources within their department."));
        }
      }

      const { action, rejectionReason, category, tags } = req.body;
      const previousState = {
        status: resource.status,
        moderationStatus: resource.moderationStatus,
        verificationStatus: resource.verificationStatus,
        rejectionReason: resource.rejectionReason
      };

      if (category) {
        resource.category = category;
      }
      if (tags && Array.isArray(tags)) {
        resource.tags = tags;
      }

      resource.moderatedBy = user.id;
      resource.moderatedByName = user.name;
      resource.moderatedAt = new Date().toISOString();
      resource.updatedAt = new Date().toISOString();

      if (action === "approve") {
        resource.status = "approved";
        resource.moderationStatus = "approved";
        if (resource.verificationStatus === "rejected") {
          resource.verificationStatus = "student_uploaded";
        }
        resource.rejectionReason = undefined;

        // Reward points to uploader (+15 points for approved contribution)
        const uploader = db.getUserById(resource.uploaderId);
        if (uploader) {
          uploader.points = (uploader.points || 0) + 15;
          db.saveUser(uploader);

          db.saveNotification({
            id: `notif-${Date.now()}-approved`,
            userId: uploader.id,
            category: "academic",
            type: "resource_approved",
            title: "Your Academic Resource was Approved (+15 Pts) 🎉",
            titleAr: "تمت الموافقة على مرجعك الأكاديمي (+15 نقطة) 🎉",
            message: `Your resource "${resource.title}" was approved by ${user.name} and is now available to all students.`,
            messageAr: `تمت مراجعة واعتماد ملفك الأكاديمي "${resource.title}" بواسطة ${user.name} وحصلت على +15 نقطة.`,
            read: false,
            createdAt: new Date().toISOString(),
            actionTab: "courses",
            actionTargetId: resource.courseId
          });
        }
      } else if (action === "verify") {
        resource.status = "approved";
        resource.moderationStatus = "approved";
        resource.verificationStatus = "verified";
        resource.rejectionReason = undefined;

        // Reward extra points for Verified quality (+25 points)
        const uploader = db.getUserById(resource.uploaderId);
        if (uploader) {
          uploader.points = (uploader.points || 0) + 25;
          db.saveUser(uploader);

          db.saveNotification({
            id: `notif-${Date.now()}-verified`,
            userId: uploader.id,
            category: "academic",
            type: "resource_verified",
            title: "Resource Verified & Badged (+25 Pts) ⭐",
            titleAr: "تم توثيق واعتماد مرجعك الأكاديمي بشارة التوثيق (+25 نقطة) ⭐",
            message: `Your resource "${resource.title}" received the Verified Resource Badge from ${user.name}.`,
            messageAr: `حصل ملفك "${resource.title}" على شارة المرجع الموثق (Verified) من إدارة الكلية لجودته العالية.`,
            read: false,
            createdAt: new Date().toISOString(),
            actionTab: "courses",
            actionTargetId: resource.courseId
          });
        }
      } else if (action === "reject") {
        if (!rejectionReason || rejectionReason.trim().length < 5) {
          return next(new BadRequestError("A specific rejection reason is mandatory when rejecting a student contribution."));
        }
        resource.status = "rejected";
        resource.moderationStatus = "rejected";
        resource.verificationStatus = "rejected";
        resource.rejectionReason = rejectionReason.trim();

        // Notify uploader with constructive rejection reason
        db.saveNotification({
          id: `notif-${Date.now()}-rejected`,
          userId: resource.uploaderId,
          category: "academic",
          type: "resource_rejected",
          title: "Resource Submission Update",
          titleAr: "تحديث حول الملف الأكاديمي المرفوع",
          message: `Your resource "${resource.title}" was not approved. Reason: ${rejectionReason}`,
          messageAr: `لم تتم الموافقة على نشر ملفك "${resource.title}". سبب الرفض: ${rejectionReason}`,
          read: false,
          createdAt: new Date().toISOString(),
          actionTab: "courses",
          actionTargetId: resource.courseId
        });
      } else if (action === "unverify") {
        resource.verificationStatus = "student_uploaded";
      }

      db.saveResource(resource);
      serverCache.invalidatePattern("resources:");

      AuditLogger.log({
        category: "moderation",
        eventType: `resource.decision.${action}`,
        severity: action === "reject" ? "warning" : "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        targetId: resource.id,
        targetType: "resource",
        targetName: resource.title,
        previousState,
        newState: {
          status: resource.status,
          moderationStatus: resource.moderationStatus,
          verificationStatus: resource.verificationStatus,
          rejectionReason: resource.rejectionReason
        },
        ipAddress: getClientIp(req)
      });

      res.json({
        success: true,
        resource: db.toSafeResource(resource, user.id),
        message: `تم اتخاذ القرار (${action}) بنجاح للملف الأكاديمي.`
      });
    }
  );

  // POST /api/resources/:id/vote (Upvote / Helpful / Not Helpful Feedback)
  app.post(
    "/api/resources/:id/vote",
    validate({
      params: {
        id: Validators.string(1, 100)
      },
      body: {
        voteType: Validators.enum(["helpful", "not_helpful"])
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("You must be signed in to vote on resources."));
      }

      const { id } = req.params;
      const { voteType } = req.body;

      const result = db.voteResource(id, user.id, voteType);
      if (!result) {
        return next(new NotFoundError("Resource not found."));
      }

      res.json(result);
    }
  );

  // ----------------------------------------------------
  // COMMUNITY & DISCUSSIONS API (Indexed, Cached, Paginated)
  // ----------------------------------------------------

  app.get("/api/posts", (req: Request, res: Response) => {
    const user = getSessionUser(req);
    const { category, departmentId, courseId, isSolved, search, sortBy } = req.query;
    const { page, limit } = sanitizePagination(req.query, 20, 50);

    const result = db.queryPosts({
      category: category as string,
      departmentId: departmentId as string,
      courseId: courseId as string,
      isSolved: isSolved !== undefined ? isSolved === "true" : undefined,
      search: search as string,
      sortBy: (sortBy as any) || "recent",
      page,
      limit,
      currentUserId: user?.id
    });

    res.json(result);
  });

  app.post(
    "/api/posts",
    validate({
      body: {
        title: Validators.string(5, 200),
        content: Validators.string(10, 5000),
        courseId: Validators.optional(Validators.string(2, 50)),
        courseCode: Validators.optional(Validators.string(2, 50)),
        departmentId: Validators.optional(Validators.string(2, 50)),
        postType: Validators.optional(Validators.enum(["question", "resource_share", "study_tip", "discussion"])),
        tags: Validators.optional(Validators.array(Validators.string(1, 30), 0, 10))
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("You must be logged in to create a post."));
      }

      const { title, content, courseId, courseCode, departmentId, postType, tags } = req.body;

      const newPost = {
        id: `disc-${Date.now()}`,
        courseId: courseId || "course-general",
        courseCode: courseCode || "ENG",
        departmentId: departmentId || user.departmentId || "dept-cmp",
        title: title.trim(),
        content: content.trim(),
        postType: postType || "question",
        authorId: user.id,
        authorName: user.name,
        authorDepartment: user.departmentId === "dept-mtr" ? "هندسة الميكاترونكس" : "هندسة الحاسب والذكاء الاصطناعي",
        authorRole: user.role,
        authorAvatar: user.avatar,
        createdAt: new Date().toISOString(),
        upvotes: 0,
        upvotedUsers: new Set<string>(),
        replyCount: 0,
        isSolved: false,
        views: 1,
        tags: Array.isArray(tags) && tags.length > 0 ? tags : ["General", "Engineering"]
      };

      db.savePost(newPost);

      // Award +5 points for asking
      user.points = (user.points || 0) + 5;
      db.saveUser(user);

      AuditLogger.log({
        category: "moderation",
        eventType: "community.post.created",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        targetId: newPost.id,
        targetType: "post",
        targetName: newPost.title,
        ipAddress: getClientIp(req)
      });

      res.status(201).json({
        success: true,
        post: db.toSafePost(newPost, user.id),
        message: "تم نشر الموضوع بنجاح وحصلت على +5 نقاط!"
      });
    }
  );

  app.post(
    "/api/posts/:id/upvote",
    validate({
      params: {
        id: Validators.string(1, 100)
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError());
      }

      const { id } = req.params;
      const post = db.getPostById(id);
      if (!post) {
        return next(new NotFoundError("Post not found."));
      }

      let hasUpvoted = false;
      if (post.upvotedUsers.has(user.id)) {
        post.upvotedUsers.delete(user.id);
        post.upvotes = Math.max(0, post.upvotes - 1);
        hasUpvoted = false;
      } else {
        post.upvotedUsers.add(user.id);
        post.upvotes += 1;
        hasUpvoted = true;
      }

      res.json({ success: true, upvotes: post.upvotes, hasUpvoted });
    }
  );

  app.get(
    "/api/posts/:id/comments",
    validate({
      params: {
        id: Validators.string(1, 100)
      }
    }),
    (req: Request, res: Response) => {
      const user = getSessionUser(req);
      const { id } = req.params;
      const comments = db.getCommentsForPost(id, user?.id);
      res.json({ comments });
    }
  );

  app.post(
    "/api/posts/:id/comments",
    validate({
      params: {
        id: Validators.string(1, 100)
      },
      body: {
        content: Validators.string(3, 3000)
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("You must be logged in to reply."));
      }

      const { id } = req.params;
      const post = db.getPostById(id);
      if (!post) {
        return next(new NotFoundError("Post not found."));
      }

      const { content } = req.body;

      const newComment = {
        id: `cmt-${Date.now()}`,
        targetId: id,
        authorId: user.id,
        authorName: user.name,
        authorDepartment: user.departmentId === "dept-mtr" ? "هندسة الميكاترونكس" : "هندسة الحاسب",
        authorRole: user.role,
        authorAvatar: user.avatar,
        content: content.trim(),
        createdAt: new Date().toISOString(),
        upvotes: 0,
        upvotedUsers: new Set<string>(),
        isSolution: false
      };

      db.saveComment(newComment);
      post.replyCount += 1;

      // Award +5 points for answering
      user.points = (user.points || 0) + 5;
      db.saveUser(user);

      // Notify post author if different
      if (post.authorId && post.authorId !== user.id) {
        db.saveNotification({
          id: `notif-${Date.now()}`,
          userId: post.authorId,
          category: "community",
          type: "new_reply",
          title: "New Reply on your Post",
          titleAr: "رد جديد على منشورك الأكاديمي",
          message: `${user.name} added a reply to "${post.title.substring(0, 45)}..."`,
          messageAr: `أضاف ${user.name} رداً على منشورك "${post.title.substring(0, 45)}..."`,
          read: false,
          createdAt: new Date().toISOString(),
          actionTab: "community",
          actionTargetId: post.id
        });
      }

      res.status(201).json({
        success: true,
        comment: db.toSafeComment(newComment, user.id),
        message: "تمت إضافة الرد بنجاح!"
      });
    }
  );

  app.post(
    "/api/posts/:id/solve",
    validate({
      params: {
        id: Validators.string(1, 100)
      },
      body: {
        commentId: Validators.string(1, 100)
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError());
      }

      const { id } = req.params;
      const { commentId } = req.body;

      const post = db.getPostById(id);
      if (!post) {
        return next(new NotFoundError("Post not found."));
      }

      // Authorization: author or elevated moderator/admin
      const isAuthor = post.authorId === user.id;
      const isElevated = ["super_admin", "department_admin", "moderator", "supervisor"].includes(user.role);

      if (!isAuthor && !isElevated) {
        AuditLogger.log({
          category: "security",
          eventType: "security.unauthorized_solve_attempt",
          severity: "warning",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          targetId: id,
          targetType: "post",
          ipAddress: getClientIp(req)
        });
        return next(new ForbiddenError("Only the post author or a moderator can verify solutions."));
      }

      const postComments = db.commentsByPostIndex.get(id) || [];
      const comment = postComments.find((c) => c.id === commentId);
      if (!comment) {
        return next(new NotFoundError("Comment not found on this post."));
      }

      comment.isSolution = true;
      post.isSolved = true;

      // Award +10 points to solver
      const solver = db.getUserById(comment.authorId);
      if (solver) {
        solver.points = (solver.points || 0) + 10;
        db.saveUser(solver);

        db.saveNotification({
          id: `notif-${Date.now()}`,
          userId: solver.id,
          category: "community",
          type: "solution_accepted",
          title: "Your Solution was Verified (+10 Pts)",
          titleAr: "تم اعتماد حلك كحل نموذجي (+10 نقاط)",
          message: `Your answer on "${post.title.substring(0, 45)}..." was marked as the official solution.`,
          messageAr: `تم اعتماد إجابتك على "${post.title.substring(0, 45)}..." كحل نموذجي معتمد وحصلت على +10 نقاط.`,
          read: false,
          createdAt: new Date().toISOString(),
          actionTab: "community",
          actionTargetId: post.id
        });
      }

      AuditLogger.log({
        category: "moderation",
        eventType: "moderation.post.solved",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        targetId: post.id,
        targetType: "post",
        targetName: post.title,
        newState: { commentId, solverId: comment.authorId },
        ipAddress: getClientIp(req)
      });

      res.json({
        success: true,
        message: "تم اعتماد الحل بنجاح ومكافأة المجيب بـ +10 نقاط!",
        isSolved: true
      });
    }
  );

  // ----------------------------------------------------
  // AI STUDY ASSISTANT & QUIZ GENERATION
  // ----------------------------------------------------

  app.post(
    "/api/ai/assistant",
    validate({
      body: {
        prompt: Validators.optional(Validators.string(1, 4000)),
        query: Validators.optional(Validators.string(1, 4000)),
        userMsg: Validators.optional(Validators.string(1, 4000)),
        courseCode: Validators.optional(Validators.string(1, 50)),
        courseTitle: Validators.optional(Validators.string(1, 100)),
        fileContext: Validators.optional(Validators.string(1, 4000))
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      const clientIp = getClientIp(req);
      const rate = checkRateLimit(`ai:${user?.id || clientIp}`, 20, 60 * 1000); // 20 queries / min

      if (!rate.allowed) {
        return next(new RateLimitError(`AI Assistant rate limit reached. Please wait ${rate.remainingSeconds}s.`, rate.remainingSeconds));
      }

      const prompt = req.body.prompt || req.body.query || req.body.userMsg;
      const { courseCode, courseTitle, syllabus, fileContext, isStream } = req.body;
      const wantStream = isStream || req.query.stream === "true" || req.headers.accept?.includes("text/event-stream");

      if (!prompt) {
        return next(new BadRequestError("Prompt is required"));
      }

      const systemInstruction = `You are EngHub AI Study Buddy, an elite engineering professor and senior tutor specializing in Computer Engineering, Mechatronics, and Electrical Engineering.
Course Context: ${courseCode || "ENG"} - ${courseTitle || "Engineering Course"}.
Syllabus Topics: ${syllabus ? (Array.isArray(syllabus) ? syllabus.join(", ") : syllabus) : "General Engineering"}.
Selected Course Materials Context: ${fileContext || "General Course Syllabus and Workspace Files"}.

Guidelines:
- Provide clear, mathematically precise, step-by-step explanations.
- Format equations using clean notation or code blocks (C++, MATLAB, Python, Verilog) where appropriate.
- Be encouraging, concise, and structured with clear headings.
- Do NOT mention model names, version numbers, or provider names. You are strictly 'AI Study Buddy' or 'المساعد الدراسي AI'.`;

      const errorMessageArabic = "المساعد الذكي غير متاح حالياً، حاول مرة أخرى لاحقاً";

      if (!process.env.GEMINI_API_KEY) {
        if (wantStream) {
          res.setHeader("Content-Type", "text/event-stream");
          res.setHeader("Cache-Control", "no-cache");
          res.setHeader("Connection", "keep-alive");
          res.write(`data: ${JSON.stringify({ error: errorMessageArabic, text: errorMessageArabic })}\n\n`);
          res.write("data: [DONE]\n\n");
          return res.end();
        }
        return next(new ServiceUnavailableError(errorMessageArabic));
      }

      try {
        const ai = getGenAI();

        AuditLogger.log({
          category: "ai",
          eventType: "ai.assistant.invoked",
          severity: "info",
          actorId: user?.id || "guest",
          actorName: user?.name || "Guest Student",
          actorRole: user?.role || "student",
          targetType: "ai_assistant",
          metadata: { courseCode, isStream: Boolean(wantStream) },
          ipAddress: clientIp
        });

        if (wantStream) {
          res.setHeader("Content-Type", "text/event-stream");
          res.setHeader("Cache-Control", "no-cache");
          res.setHeader("Connection", "keep-alive");

          const responseStream = await ai.models.generateContentStream({
            model: "gemini-3.6-flash",
            contents: prompt,
            config: {
              systemInstruction,
              temperature: 0.7,
            },
          });

          for await (const chunk of responseStream) {
            if (chunk.text) {
              res.write(`data: ${JSON.stringify({ text: chunk.text })}\n\n`);
            }
          }
          res.write("data: [DONE]\n\n");
          return res.end();
        }

        const response = await ai.models.generateContent({
          model: "gemini-3.6-flash",
          contents: prompt,
          config: {
            systemInstruction,
            temperature: 0.7,
          },
        });

        const replyText = response.text || "No response generated.";
        res.json({
          reply: replyText,
          answer: replyText
        });
      } catch (geminiErr: any) {
        console.error("Gemini API error:", geminiErr?.message || geminiErr);
        if (wantStream) {
          if (!res.headersSent) {
            res.setHeader("Content-Type", "text/event-stream");
            res.setHeader("Cache-Control", "no-cache");
            res.setHeader("Connection", "keep-alive");
          }
          res.write(`data: ${JSON.stringify({ error: errorMessageArabic, text: errorMessageArabic })}\n\n`);
          res.write("data: [DONE]\n\n");
          return res.end();
        }
        if (res.headersSent) {
          return;
        }
        return next(new ServiceUnavailableError(errorMessageArabic));
      }
    }
  );

  const handleQuizGeneration = async (req: Request, res: Response, next: NextFunction) => {
    const { courseCode, courseTitle, topic } = req.body;
    const errorMessageArabic = "المساعد الذكي غير متاح حالياً، حاول مرة أخرى لاحقاً";

    if (!process.env.GEMINI_API_KEY) {
      return next(new ServiceUnavailableError(errorMessageArabic));
    }

    try {
      const quizPrompt = `Generate 4 high-yield multiple-choice exam practice questions for engineering students in ${courseCode || "Engineering"} - ${courseTitle || topic || "Course"}.
Topic: ${topic || "General Course Material"}.

Return ONLY a raw JSON array of objects without markdown formatting or code fences. Each object must have:
- "id": string
- "question": string
- "options": array of 4 strings
- "correctIndex": integer (0, 1, 2, or 3)
- "explanation": string`;

      const ai = getGenAI();
      const response = await ai.models.generateContent({
        model: "gemini-3.6-flash",
        contents: quizPrompt,
        config: {
          responseMimeType: "application/json",
          responseSchema: {
            type: Type.ARRAY,
            description: "Array of quiz questions",
            items: {
              type: Type.OBJECT,
              properties: {
                id: { type: Type.STRING },
                question: { type: Type.STRING },
                options: {
                  type: Type.ARRAY,
                  items: { type: Type.STRING },
                  description: "4 distinct options"
                },
                correctIndex: { type: Type.INTEGER, description: "0-based index of correct option" },
                explanation: { type: Type.STRING }
              },
              required: ["id", "question", "options", "correctIndex", "explanation"]
            }
          }
        }
      });

      const jsonStr = response.text || "[]";
      const parsed = JSON.parse(jsonStr);

      if (Array.isArray(parsed) && parsed.length > 0) {
        return res.json({ questions: parsed, quiz: parsed });
      } else {
        return next(new ServiceUnavailableError(errorMessageArabic));
      }
    } catch (error) {
      console.error("AI Quiz Generator Error:", error);
      return next(new ServiceUnavailableError(errorMessageArabic));
    }
  };

  app.post("/api/ai/generate-quiz", handleQuizGeneration);
  app.post("/api/ai/quiz", handleQuizGeneration);

  // ----------------------------------------------------
  // EXAM & QUIZ SUBMISSION
  // ----------------------------------------------------

  app.post(
    "/api/quiz/submit",
    validate({
      body: {
        quizId: Validators.string(1, 100),
        quizTitle: Validators.optional(Validators.string(1, 200)),
        courseCode: Validators.optional(Validators.string(1, 50)),
        answers: Validators.array(undefined, 1, 100),
        totalQuestions: Validators.optional(Validators.integer(1, 100))
      }
    }),
    (req: Request, res: Response) => {
      const user = getSessionUser(req);
      const { quizId, quizTitle, courseCode, answers, totalQuestions } = req.body;

      let correctCount = 0;
      const gradedAnswers = answers.map((ans: any) => {
        const isCorrect = ans.selectedIndex === ans.correctIndex;
        if (isCorrect) correctCount++;
        return {
          questionId: ans.questionId,
          selectedIndex: ans.selectedIndex,
          correctIndex: ans.correctIndex,
          isCorrect
        };
      });

      const total = totalQuestions || answers.length || 1;
      const percentage = Math.round((correctCount / total) * 100);
      const passed = percentage >= 60;
      const pointsEarned = passed ? Math.min(25, Math.max(10, Math.round(percentage / 5))) : 5;

      if (user) {
        user.points = (user.points || 0) + pointsEarned;
        db.saveUser(user);
      }

      res.json({
        success: true,
        submission: {
          id: `sub-${Date.now()}`,
          quizId,
          quizTitle: quizTitle || "Engineering Quiz",
          courseCode: courseCode || "ENG",
          studentName: user ? user.name : "Guest Student",
          score: correctCount,
          totalQuestions: total,
          percentage,
          passed,
          pointsEarned,
          answers: gradedAnswers,
          submittedAt: new Date().toISOString()
        }
      });
    }
  );

  // ----------------------------------------------------
  // STUDY & FOCUS LOGGING
  // ----------------------------------------------------

  app.post("/api/study/pomodoro/log", (req: Request, res: Response) => {
    const user = getSessionUser(req);
    const { courseId, courseCode, taskName, durationMinutes, mode } = req.body;

    const pointsEarned = mode === "focus" && (durationMinutes || 25) >= 20 ? 5 : 0;
    if (user && pointsEarned > 0) {
      user.points = (user.points || 0) + pointsEarned;
      db.saveUser(user);
    }

    res.json({
      success: true,
      session: {
        id: `pomo-${Date.now()}`,
        userId: user ? user.id : "guest",
        courseId: courseId || "general",
        courseCode: courseCode || "ENG",
        taskName: taskName || "Engineering Study Session",
        durationMinutes: durationMinutes || 25,
        mode: mode || "focus",
        completedAt: new Date().toISOString(),
        pointsAwarded: pointsEarned
      },
      message: pointsEarned > 0 ? `تم تسجيل جلسة التركيز بنجاح وإضافة +${pointsEarned} نقاط!` : "تم تسجيل الجلسة بنجاح!"
    });
  });

  // ----------------------------------------------------
  // HIGH-PERFORMANCE CACHED ENDPOINTS (COURSES, SCHEDULES, EXAMS)
  // Cache-Aside Strategy with Redis (TTL = 3600s / 1 hour)
  // Invalidation on Create / Update / Delete
  // ----------------------------------------------------

  // 1. COURSES
  app.get("/api/courses", async (req: Request, res: Response) => {
    const departmentId = (req.query.departmentId as string) || "all";
    const level = (req.query.level as string) || "all";
    const semester = (req.query.semester as string) || "all";
    const q = (req.query.q as string) || "";
    const page = parseInt(req.query.page as string, 10) || 1;
    const limit = parseInt(req.query.limit as string, 10) || 50;

    const cacheKey = `courses:list:${departmentId}:${level}:${semester}:${q}:${page}:${limit}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    try {
      const result = await CourseService.getAllCourses({ departmentId, level, semester, q, page, limit });
      await serverCache.set(cacheKey, result, 3600, ["courses"]);
      res.setHeader("X-Cache", "MISS");
      res.json(result);
    } catch (err) {
      console.warn("Prisma course query fallback to db memory store:", err);
      const fallbackResult = db.queryCourses({ departmentId, level, semester, q, page, limit });
      res.json(fallbackResult);
    }
  });

  app.get("/api/courses/:id", async (req: Request, res: Response, next: NextFunction) => {
    const { id } = req.params;
    const cacheKey = `courses:detail:${id}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    try {
      const course = await CourseService.getCourseById(id);
      if (!course) {
        return next(new NotFoundError("Course not found"));
      }

      await serverCache.set(cacheKey, course, 3600, ["courses"]);
      res.setHeader("X-Cache", "MISS");
      res.json(course);
    } catch (err) {
      const fallback = db.getCourseById(id);
      if (!fallback) return next(new NotFoundError("Course not found"));
      res.json(fallback);
    }
  });

  app.post(
    "/api/courses",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const courseData = req.body;

      if (!courseData.code || !courseData.title) {
        return next(new ValidationError("Course code and title are required."));
      }

      console.log("[PRISMA_WRITE_START] Creating course in PostgreSQL with payload:", JSON.stringify(courseData));

      try {
        const saved = await CourseService.createCourse(courseData);
        console.log("[PRISMA_WRITE_SUCCESS] Course created in PostgreSQL:", JSON.stringify(saved));

        // Invalidate courses cache
        await serverCache.invalidatePattern("courses:");
        await serverCache.invalidateTag("courses");
        await serverCache.delete("analytics:summary");
        await serverCache.invalidatePattern("admin:stats:");

        AuditLogger.log({
          category: "administration",
          eventType: "admin.create_course",
          severity: "info",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { courseId: saved.id, courseCode: saved.code, title: saved.title }
        });

        res.status(201).json({
          success: true,
          course: saved,
          message: "تم إنشاء المقرر الدراسي بنجاح وحفظه في قاعدة البيانات."
        });
      } catch (err: any) {
        console.error("[PRISMA_WRITE_ERROR] Failed to save course in database:", err);
        return next(new BadRequestError(err.message || "Failed to create course in database"));
      }
    }
  );

  app.patch(
    "/api/courses/:id",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;

      console.log("[PRISMA_UPDATE_START] Updating course in PostgreSQL:", id, JSON.stringify(req.body));

      try {
        const updated = await CourseService.updateCourse(id, req.body);
        console.log("[PRISMA_UPDATE_SUCCESS] Course updated in PostgreSQL:", JSON.stringify(updated));

        await serverCache.invalidatePattern("courses:");
        await serverCache.invalidateTag("courses");

        AuditLogger.log({
          category: "administration",
          eventType: "admin.update_course",
          severity: "info",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { courseId: id }
        });

        res.json({ success: true, course: updated });
      } catch (err: any) {
        console.error("[PRISMA_UPDATE_ERROR] Failed to update course:", err);
        return next(new BadRequestError(err.message || "Failed to update course"));
      }
    }
  );

  app.delete(
    "/api/courses/:id",
    requireRole(["super_admin", "department_admin"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;

      console.log("[PRISMA_DELETE_START] Archiving course in PostgreSQL:", id);

      try {
        await CourseService.deleteCourse(id);
        console.log("[PRISMA_DELETE_SUCCESS] Course archived in PostgreSQL:", id);

        await serverCache.invalidatePattern("courses:");
        await serverCache.invalidateTag("courses");
        await serverCache.delete("analytics:summary");
        await serverCache.invalidatePattern("admin:stats:");

        AuditLogger.log({
          category: "administration",
          eventType: "admin.delete_course",
          severity: "warning",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { courseId: id }
        });

        res.json({ success: true, message: "Course deleted and archived from database." });
      } catch (err: any) {
        console.error("[PRISMA_DELETE_ERROR] Failed to delete course:", err);
        return next(new BadRequestError(err.message || "Failed to delete course"));
      }
    }
  );

  // 2. LECTURE SCHEDULES
  app.get("/api/schedules", async (req: Request, res: Response) => {
    const departmentId = (req.query.departmentId as string) || "all";
    const level = (req.query.level as string) || "all";
    const courseId = (req.query.courseId as string) || "all";
    const dayOfWeek = (req.query.dayOfWeek as string) || "all";

    const cacheKey = `schedules:list:${departmentId}:${level}:${courseId}:${dayOfWeek}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    const result = db.querySchedules({ departmentId, level, courseId, dayOfWeek });
    await serverCache.set(cacheKey, result, 3600, ["schedules"]);
    res.setHeader("X-Cache", "MISS");
    res.json(result);
  });

  app.get("/api/schedules/:id", async (req: Request, res: Response, next: NextFunction) => {
    const { id } = req.params;
    const cacheKey = `schedules:detail:${id}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    const schedule = db.getScheduleById(id);
    if (!schedule) {
      return next(new NotFoundError("Schedule record not found"));
    }

    await serverCache.set(cacheKey, schedule, 3600, ["schedules"]);
    res.setHeader("X-Cache", "MISS");
    res.json(schedule);
  });

  app.post(
    "/api/schedules",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    validate({
      body: {
        courseId: Validators.string(1, 50),
        courseCode: Validators.string(1, 20),
        courseTitle: Validators.string(2, 100),
        instructor: Validators.string(2, 100),
        dayOfWeek: Validators.string(2, 20),
        startTime: Validators.string(2, 10),
        endTime: Validators.string(2, 10),
        hall: Validators.string(1, 50),
        type: Validators.enum(["lecture", "section", "lab"]),
        departmentId: Validators.string(1, 50),
        level: Validators.string(1, 50)
      }
    }),
    async (req: Request, res: Response) => {
      const user = (req as any).user as StoredUser;
      const scheduleData = req.body;
      const newSchedule = {
        id: `sched-${Date.now()}`,
        ...scheduleData
      };

      const saved = db.saveSchedule(newSchedule);

      await serverCache.invalidatePattern("schedules:");
      await serverCache.invalidateTag("schedules");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.create_schedule",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { scheduleId: saved.id, courseCode: saved.courseCode }
      });

      res.status(201).json({
        success: true,
        schedule: saved,
        message: "تم حفظ الجدول الدراسي وإلغاء الذاكرة المؤقتة بنجاح."
      });
    }
  );

  app.patch(
    "/api/schedules/:id",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;
      const existing = db.getScheduleById(id);
      if (!existing) {
        return next(new NotFoundError("Schedule record not found"));
      }

      const updated = { ...existing, ...req.body, id };
      db.saveSchedule(updated);

      await serverCache.invalidatePattern("schedules:");
      await serverCache.invalidateTag("schedules");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.update_schedule",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { scheduleId: id }
      });

      res.json({ success: true, schedule: updated });
    }
  );

  app.delete(
    "/api/schedules/:id",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;
      const deleted = db.deleteSchedule(id);
      if (!deleted) {
        return next(new NotFoundError("Schedule record not found"));
      }

      await serverCache.invalidatePattern("schedules:");
      await serverCache.invalidateTag("schedules");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.delete_schedule",
        severity: "warning",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { scheduleId: id }
      });

      res.json({ success: true, message: "Schedule item deleted and cache invalidated." });
    }
  );

  // 3. EXAMS & QUESTION BANK
  app.get("/api/exams", async (req: Request, res: Response) => {
    const departmentId = (req.query.departmentId as string) || "all";
    const courseId = (req.query.courseId as string) || "all";
    const topic = (req.query.topic as string) || "all";
    const difficulty = (req.query.difficulty as string) || "all";
    const term = (req.query.term as string) || "all";
    const isPastExam = req.query.isPastExam !== undefined ? req.query.isPastExam === "true" : undefined;
    const q = (req.query.q as string) || "";
    const page = parseInt(req.query.page as string, 10) || 1;
    const limit = parseInt(req.query.limit as string, 10) || 50;

    const cacheKey = `exams:list:${departmentId}:${courseId}:${topic}:${difficulty}:${term}:${isPastExam ?? 'all'}:${q}:${page}:${limit}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    const result = db.queryExams({ departmentId, courseId, topic, difficulty, term, isPastExam, q, page, limit });
    await serverCache.set(cacheKey, result, 3600, ["exams"]);
    res.setHeader("X-Cache", "MISS");
    res.json(result);
  });

  app.get("/api/exams/:id", async (req: Request, res: Response, next: NextFunction) => {
    const { id } = req.params;
    const cacheKey = `exams:detail:${id}`;
    const cached = await serverCache.get(cacheKey);
    if (cached) {
      res.setHeader("X-Cache", "HIT");
      return res.json(cached);
    }

    const exam = db.getExamById(id);
    if (!exam) {
      return next(new NotFoundError("Exam or question bank record not found"));
    }

    await serverCache.set(cacheKey, exam, 3600, ["exams"]);
    res.setHeader("X-Cache", "MISS");
    res.json(exam);
  });

  app.post(
    "/api/exams",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    validate({
      body: {
        courseId: Validators.string(1, 50),
        courseCode: Validators.string(1, 20),
        title: Validators.string(3, 150),
        topic: Validators.string(2, 100),
        durationMinutes: Validators.number(5, 300),
        totalMarks: Validators.number(1, 500),
        difficulty: Validators.enum(["Easy", "Medium", "Hard"]),
        term: Validators.string(2, 50),
        isPastExam: Validators.optional(Validators.boolean()),
        questions: Validators.array(Validators.object(), 1, 100)
      }
    }),
    async (req: Request, res: Response) => {
      const user = (req as any).user as StoredUser;
      const examData = req.body;
      const newExam = {
        id: `exam-${Date.now()}`,
        ...examData,
        createdAt: new Date().toISOString()
      };

      const saved = db.saveExam(newExam);

      await serverCache.invalidatePattern("exams:");
      await serverCache.invalidateTag("exams");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.create_exam",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { examId: saved.id, title: saved.title }
      });

      res.status(201).json({
        success: true,
        exam: saved,
        message: "تم حفظ الاختبار في بنك الأسئلة وإلغاء الذاكرة المؤقتة بنجاح."
      });
    }
  );

  app.patch(
    "/api/exams/:id",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;
      const existing = db.getExamById(id);
      if (!existing) {
        return next(new NotFoundError("Exam record not found"));
      }

      const updated = {
        ...existing,
        ...req.body,
        id
      };
      db.saveExam(updated);

      await serverCache.invalidatePattern("exams:");
      await serverCache.invalidateTag("exams");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.update_exam",
        severity: "info",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { examId: id }
      });

      res.json({ success: true, exam: updated });
    }
  );

  app.delete(
    "/api/exams/:id",
    requireRole(["super_admin", "department_admin", "supervisor"]),
    async (req: Request, res: Response, next: NextFunction) => {
      const user = (req as any).user as StoredUser;
      const { id } = req.params;
      const deleted = db.deleteExam(id);
      if (!deleted) {
        return next(new NotFoundError("Exam record not found"));
      }

      await serverCache.invalidatePattern("exams:");
      await serverCache.invalidateTag("exams");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.delete_exam",
        severity: "warning",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        ipAddress: getClientIp(req),
        metadata: { examId: id }
      });

      res.json({ success: true, message: "Exam record deleted and cache invalidated." });
    }
  );

  // ----------------------------------------------------
  // ADMIN & OBSERVABILITY ROUTES
  // ----------------------------------------------------

  // Admin Overview & System Stats (Cached with TTL)
  app.get("/api/admin/stats", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError("Authentication required to access admin statistics."));
    }
    if (!["super_admin", "department_admin", "moderator"].includes(user.role)) {
      return next(new ForbiddenError("Elevated administrative access required to view statistics."));
    }

    const role = user.role;

    const cacheKey = `admin:stats:${role}`;
    const cached = serverCache.get(cacheKey);
    if (cached) {
      return res.json(cached);
    }

    const stats = {
      totalUsers: Math.max(db.usersById.size, 18),
      approvedFiles: 420,
      pendingQueue: 2,
      totalCourses: 34,
      totalDownloadsThisMonth: 3850,
      role: role,
      systemStatus: "healthy",
      securityMetrics: AuditLogger.getMetrics()
    };

    serverCache.set(cacheKey, stats, 60 * 1000, ["admin"]); // 1 min TTL
    res.json(stats);
  });

  // Admin User Directory (Server-Side Filtered & Paginated)
  app.get("/api/admin/users", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError("Authentication required. Please sign in with an elevated administrative account."));
    }
    if (user.role === "student") {
      return next(new ForbiddenError("Elevated administrative access required to view user directory."));
    }

    const { page, limit } = sanitizePagination(req.query, 20, 100);
    const search = typeof req.query.search === "string" ? req.query.search : undefined;
    const department = typeof req.query.department === "string" ? req.query.department : undefined;
    const level = typeof req.query.level === "string" ? req.query.level : undefined;
    const role = typeof req.query.role === "string" ? req.query.role : undefined;

    const result = db.queryUsers({ search, department, level, role, page, limit });
    res.json(result);
  });

  // Admin Role Management
  app.post(
    "/api/admin/update-role",
    validate({
      body: {
        targetUserId: Validators.optional(Validators.string(1, 100)),
        targetEmail: Validators.optional(Validators.email()),
        newRole: Validators.enum(["student", "moderator", "department_admin", "supervisor", "super_admin"]),
        supervisorScope: Validators.optional(Validators.string(1, 200)),
        supervisorTitle: Validators.optional(Validators.string(1, 100))
      }
    }),
    (req: Request, res: Response, next: NextFunction) => {
      const user = getSessionUser(req);
      if (!user) {
        return next(new UnauthorizedError("Authentication required."));
      }

      if (user.role !== "super_admin" && user.role !== "department_admin") {
        AuditLogger.log({
          category: "security",
          eventType: "security.forbidden_role_change",
          severity: "critical",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req)
        });
        return next(new ForbiddenError("Admin privileges required to modify user roles."));
      }

      const { targetUserId, targetEmail, newRole, supervisorScope, supervisorTitle } = req.body;
      if (!targetEmail && !targetUserId) {
        return next(new BadRequestError("targetEmail or targetUserId is required."));
      }

      if (newRole === "super_admin" && user.role !== "super_admin") {
        AuditLogger.log({
          category: "security",
          eventType: "security.forbidden_role_change",
          severity: "critical",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { attemptedRole: newRole, reason: "non_super_admin_cannot_assign_super_admin" }
        });
        return next(new ForbiddenError("Only super administrators may assign the super_admin role."));
      }

      if (user.role === "department_admin" && ["super_admin", "department_admin"].includes(newRole)) {
        AuditLogger.log({
          category: "security",
          eventType: "security.forbidden_role_change",
          severity: "critical",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { attemptedRole: newRole, reason: "department_admin_cannot_assign_elevated_roles" }
        });
        return next(new ForbiddenError("Department administrators may not assign super_admin or department_admin roles."));
      }

      let targetUser: StoredUser | null = null;
      if (targetUserId) {
        targetUser = db.getUserById(targetUserId);
      }
      if (!targetUser && targetEmail) {
        targetUser = db.getUserByEmail(targetEmail.trim().toLowerCase());
      }

      if (!targetUser) {
        if (user.role !== "super_admin") {
          return next(new ForbiddenError("Only super administrators may create new user accounts with elevated roles."));
        }

        const cleanEmail = (targetEmail || `${targetUserId || "user"}@eng.gnu.edu`).trim().toLowerCase();
        const fallbackName = cleanEmail.split("@")[0].replace(/[._-]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
        targetUser = {
          id: targetUserId || `usr-${Date.now()}`,
          name: fallbackName || "Academic User",
          email: cleanEmail,
          phoneNumber: "+20 100 000 0000",
          passwordHash: "default",
          studentId: `2024-ENG-${Math.floor(1000 + Math.random() * 9000)}`,
          role: newRole,
          universityId: "uni-gnue-01",
          facultyId: "fac-eng-01",
          departmentId: "dept-cmp-01",
          level: "Year 2 (Sophomore)",
          semester: "Fall 2026",
          avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80",
          bio: "EngHub academic member.",
          points: 500,
          badges: [],
          savedBookmarks: [],
          enrolledCourseIds: ["course-cs201"],
          createdAt: new Date().toISOString()
        };
      }

      if (user.role === "department_admin" && targetUser.departmentId !== user.departmentId) {
        AuditLogger.log({
          category: "security",
          eventType: "security.forbidden_role_change",
          severity: "critical",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { targetDepartmentId: targetUser.departmentId, actorDepartmentId: user.departmentId }
        });
        return next(new ForbiddenError("Department administrators may only modify users within their own department."));
      }

      const previousRole = targetUser.role;
      targetUser.role = newRole;
      if (supervisorScope !== undefined) targetUser.supervisorScope = supervisorScope;
      if (supervisorTitle !== undefined) targetUser.supervisorTitle = supervisorTitle;
      db.saveUser(targetUser);

      // Invalidate admin cache
      serverCache.invalidatePattern("admin:");

      AuditLogger.log({
        category: "administration",
        eventType: "admin.role.updated",
        severity: "warning",
        actorId: user.id,
        actorName: user.name,
        actorRole: user.role,
        targetId: targetUser.id,
        targetType: "user",
        targetName: targetUser.name,
        previousState: { role: previousRole },
        newState: { role: newRole },
        ipAddress: getClientIp(req)
      });

      res.json({
        success: true,
        message: `User ${targetUser.name} (${targetUser.email}) role updated to ${newRole}.`,
        user: db.toSafeUser(targetUser)
      });
    }
  );

  // Admin Audit Logs Query Endpoint
  app.get("/api/admin/audit-logs", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user) {
      return next(new UnauthorizedError());
    }

    if (user.role !== "super_admin" && user.role !== "department_admin" && user.role !== "moderator") {
      return next(new ForbiddenError("Access restricted to platform administrators and supervisors."));
    }

    const { category, eventType, severity, actorId, targetId, search, startDate, endDate } = req.query;
    const { page, limit } = sanitizePagination(req.query, 20, 100);

    const result = AuditLogger.query({
      category: category as string,
      eventType: eventType as string,
      severity: severity as string,
      actorId: actorId as string,
      targetId: targetId as string,
      search: search as string,
      startDate: startDate as string,
      endDate: endDate as string,
      page,
      limit
    });

    res.json({
      success: true,
      ...result
    });
  });

  // Admin Security Metrics Aggregation Endpoint
  app.get("/api/admin/security-metrics", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user || (user.role !== "super_admin" && user.role !== "department_admin")) {
      return next(new ForbiddenError("Admin authorization required."));
    }

    res.json({
      success: true,
      metrics: AuditLogger.getMetrics(),
      cache: serverCache.getStats()
    });
  });

  // Admin Cache Invalidation Endpoint
  app.post("/api/admin/cache/clear", (req: Request, res: Response, next: NextFunction) => {
    const user = getSessionUser(req);
    if (!user || user.role !== "super_admin") {
      return next(new ForbiddenError("Super Admin privileges required."));
    }

    serverCache.clear();
    res.json({ success: true, message: "Server cache successfully flushed." });
  });

  // ----------------------------------------------------
  // TIME-LIMITED SIGNED FILE DOWNLOADS, S3 UPLOADS & CDN
  // ----------------------------------------------------

  // S3 Storage Configuration status
  app.get("/api/files/storage-config", (_req: Request, res: Response) => {
    const config = getS3StorageConfig();
    res.json({
      success: true,
      storage: {
        bucket: config?.bucket || process.env.S3_BUCKET_NAME || 'enghub-academic-vault',
        region: process.env.S3_REGION || 'auto',
        cdnDomain: config?.cdnBaseUrl || process.env.CDN_BASE_URL || 'https://cdn.eng.gnu.edu',
        isConfigured: Boolean(config),
        uploadExpirationSeconds: 900,
        downloadExpirationSeconds: 3600
      }
    });
  });

  // Direct file upload with server-side magic-byte verification
  app.post(
    "/api/files/upload-direct",
    requireAuth,
    validate({
      body: {
        fileKey: Validators.string(5, 500),
        fileName: Validators.string(3, 200),
        fileType: Validators.string(2, 10),
        fileSizeBytes: Validators.optional(Validators.integer(1, 30 * 1024 * 1024)),
        fileData: Validators.optional(Validators.string(0, 50 * 1024 * 1024)),
        courseId: Validators.string(2, 100)
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      try {
        const user = (req as any).user as StoredUser;
        const { fileKey, fileName, fileType, fileSizeBytes, fileData, courseId } = req.body;

        const maxSize = 30 * 1024 * 1024;
        const declaredSize = fileSizeBytes || 0;
        if (declaredSize > maxSize) {
          return next(new BadRequestError(`File size exceeds maximum allowed size of ${maxSize / (1024 * 1024)} MB.`));
        }

        if (!fileData || typeof fileData !== 'string' || fileData.length === 0) {
          return next(new BadRequestError('fileData is required for direct upload.'));
        }

        const buffer = Buffer.from(fileData, 'base64');
        const extension = fileName.includes('.') ? fileName.split('.').pop()!.toLowerCase() : fileType.toLowerCase();

        const { validateFileMagicBytes } = await import('./server/fileValidation');
        const validation = validateFileMagicBytes(buffer, extension);

        if (!validation.valid) {
          AuditLogger.log({
            category: "security",
            eventType: "security.upload_magic_bytes_mismatch",
            severity: "warning",
            actorId: user.id,
            actorName: user.name,
            actorRole: user.role,
            ipAddress: getClientIp(req),
            metadata: { fileName, declaredExtension: extension, error: validation.error }
          });
          return next(new BadRequestError(`File validation failed: ${validation.error}`));
        }

        const uploadDir = path.join(process.cwd(), 'uploads');
        const safeFileName = fileName.replace(/[^a-zA-Z0-9_.-]/g, '_');
        const targetPath = path.join(uploadDir, safeFileName);

        await fs.promises.writeFile(targetPath, buffer);

        AuditLogger.log({
          category: "administration",
          eventType: "file.upload_direct",
          severity: "info",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { fileKey, fileName, fileType: validation.detectedType, courseId, size: buffer.length }
        });

        res.json({
          success: true,
          fileKey,
          fileName: safeFileName,
          detectedType: validation.detectedType,
          mimeType: validation.mimeType,
          size: buffer.length,
          message: 'File uploaded and validated successfully.'
        });
      } catch (err: any) {
        next(err);
      }
    }
  );

  // Pre-signed S3 Upload URL Generation with Encrypted Filename
  app.post(
    "/api/files/presign-upload",
    requireAuth,
    validate({
      body: {
        originalFileName: Validators.string(1, 200),
        courseId: Validators.string(1, 100),
        contentType: Validators.optional(Validators.string(3, 100))
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      try {
        const user = (req as any).user as StoredUser;
        const { originalFileName, courseId, contentType = "application/pdf" } = req.body;

        const presigned = await getPresignedUploadUrl({
          originalFileName,
          courseId,
          contentType
        });

        AuditLogger.log({
          category: "administration",
          eventType: "file.presign_upload_generated",
          severity: "info",
          actorId: user.id,
          actorName: user.name,
          actorRole: user.role,
          ipAddress: getClientIp(req),
          metadata: { fileKey: presigned.fileKey, originalFileName, courseId }
        });

        res.json({
          success: true,
          ...presigned
        });
      } catch (err: any) {
        next(err);
      }
    }
  );

  // Time-Limited Signed File Download URL (S3 Presigned & CDN)
  app.get(
    "/api/files/download-url",
    validate({
      query: {
        fileId: Validators.string(1, 100)
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      const fileId = req.query.fileId as string;
      const user = getSessionUser(req);
      const resource = db.getResourceById(fileId);

      if (resource) {
        const isElevated = user && ["super_admin", "department_admin", "moderator", "supervisor"].includes(user.role);
        const isOwner = user && resource.uploaderId === user.id;

        if (resource.moderationStatus !== "approved" && !isElevated && !isOwner) {
          return next(new ForbiddenError("This resource is pending moderation review and cannot be downloaded yet."));
        }
      }

      const fileKey = (resource as any)?.fileKey || `courses/${resource?.courseId || 'general'}/${fileId}.pdf`;
      const originalFileName = resource ? resource.fileName : `${fileId}.pdf`;

      const downloadMeta = await getPresignedDownloadUrl({
        fileKey,
        originalFileName
      });

      const { token, expiresAt } = generateSignedDownloadToken(fileId, 15 * 60); // 15 mins expiry
      const fallbackUrl = `/api/files/download/${fileId}?token=${encodeURIComponent(token)}`;

      res.json({
        fileId,
        signedUrl: downloadMeta.downloadUrl || fallbackUrl,
        cdnDelivered: downloadMeta.cdnDelivered,
        expiresAt: downloadMeta.expiresAt || expiresAt
      });
    }
  );

  app.get(
    "/api/files/download/:fileId",
    validate({
      params: {
        fileId: Validators.string(1, 100)
      },
      query: {
        token: Validators.string(5, 500)
      }
    }),
    async (req: Request, res: Response, next: NextFunction) => {
      try {
        const { fileId } = req.params;
        const token = req.query.token as string;

        const isValid = verifySignedDownloadToken(fileId, token);
        if (!isValid) {
          return next(new ForbiddenError("Invalid or expired download signature. Please request a fresh signed link."));
        }

        const resource = await db.getResourceById(fileId);
        if (resource) {
          await db.incrementResourceDownload(fileId);
        }

        const filename = resource ? resource.fileName : `${fileId}.pdf`;
        res.setHeader("Content-Disposition", `attachment; filename="${encodeURIComponent(filename)}"`);
        res.setHeader("Content-Type", "application/pdf");
        res.send(`%PDF-1.4 EngHub High-Precision Academic Resource Document: ${filename}\nEngineered for Egyptian Universities Engineering Curricula.`);
      } catch (err) {
        next(err);
      }
    }
  );

  app.get("/api/analytics", (_req: Request, res: Response) => {
    const cached = serverCache.get("analytics:summary");
    if (cached) return res.json(cached);

    const summary = {
      activeStudents: 800,
      totalCourses: 34,
      totalStudyFiles: 420,
      totalDownloadsThisMonth: 3850,
      moderationQueueSize: 2,
      departmentBreakdown: [
        { name: "Computer Engineering", files: 215, students: 420 },
        { name: "Mechatronics Engineering", files: 190, students: 380 },
        { name: "Electrical Engineering", files: 15, students: 310 }
      ]
    };

    serverCache.set("analytics:summary", summary, 2 * 60 * 1000); // 2 min TTL
    res.json(summary);
  });

  // ----------------------------------------------------
  // CENTRALIZED ERROR HANDLER (Mounted after all API routes)
  // ----------------------------------------------------
  app.use("/api", errorHandler);

  // ----------------------------------------------------
  // VITE MIDDLEWARE SETUP
  // ----------------------------------------------------
  if (process.env.NODE_ENV !== "production") {
    console.log("[EngHub Server] Mounting Vite development middleware");
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(process.cwd(), "dist");
    const distIndexHtml = path.join(distPath, "index.html");
    if (fs.existsSync(distIndexHtml)) {
      console.log("[EngHub Server] Serving static built bundle from dist/");
      app.use(express.static(distPath));
      app.get("*", (_req: Request, res: Response) => {
        res.sendFile(distIndexHtml);
      });
    } else {
      console.log("[EngHub Server] Mounting Vite fallback middleware");
      const vite = await createViteServer({
        server: { middlewareMode: true },
        appType: "spa",
      });
      app.use(vite.middlewares);
    }
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`[EngHub Server] Hardened server running on http://0.0.0.0:${PORT}`);
  });
}

startServer().catch((err) => {
  console.error("[EngHub Server] Fatal error during server startup:", err);
  process.exit(1);
});
